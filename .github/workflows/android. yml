name: تشغيل مذاكرتي تلقائياً وبناء APK

on:
  workflow_dispatch:
  push:
    paths:
      - "*.zip"
      - ".github/workflows/android.yml"

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: تنزيل ملفات GitHub
        uses: actions/checkout@v4

      - name: تجهيز Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: تجهيز Android SDK
        uses: android-actions/setup-android@v3

      - name: تثبيت أدوات Android
        run: |
          sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

      - name: فك ضغط المشروع تلقائياً
        shell: bash
        run: |
          set -e
          ZIP_FILE=$(find . -maxdepth 2 -type f -iname "*.zip" \
            ! -path "./.git/*" | head -n 1)

          if [ -z "$ZIP_FILE" ]; then
            echo "ERROR: ارفع ملف ZIP للمشروع إلى المستودع أولاً"
            exit 1
          fi

          mkdir -p extracted
          unzip -oq "$ZIP_FILE" -d extracted

          echo "ملفات Gradle التي تم العثور عليها:"
          find extracted -type f \
            \( -name settings.gradle -o -name settings.gradle.kts \)

      - name: تحديد مجلد المشروع
        shell: bash
        run: |
          set -e
          SETTINGS=$(find extracted -type f \
            \( -name settings.gradle -o -name settings.gradle.kts \) \
            -print -quit)

          if [ -z "$SETTINGS" ]; then
            echo "ERROR: لم يتم العثور على settings.gradle"
            echo "تأكد أن ZIP يحتوي مشروع Android كامل وليس صوراً أو ملفات منفردة."
            exit 1
          fi

          PROJECT_DIR=$(dirname "$SETTINGS")
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"
          echo "المشروع: $PROJECT_DIR"

      - name: بناء APK
        shell: bash
        run: |
          set -e
          cd "$PROJECT_DIR"

          if [ -f "./gradlew" ]; then
            chmod +x ./gradlew
            ./gradlew --no-daemon assembleDebug
          else
            gradle --no-daemon assembleDebug
          fi

      - name: رفع APK
        uses: actions/upload-artifact@v4
        with:
          name: Mozakarty-APK
          path: extracted/**/app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
          retention-days: 7
